{
  "Retention": {
    "Enabled": true,
    "GpsDays": 90,
    "RecordYears": 1,
    "RunAtHour": 2,
    "BatchSize": 1000,
    "RetryMinutes": 15,
    "RefreshTokenGraceDays": 30
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": {
      "Console": {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "facility-realtime",
    "Audience": "facility-realtime-web",
    "AccessTokenMinutes": 5,
    "RefreshCookieSecure": false
  },
  "LoginThrottle": {
    "MaxFailures": 5,
    "LockMinutes": 15,
    "MaxFailuresPerPlace": 20
  },
  "Attendance": {
    "OpensMinutesBeforeShift": 60,
    "ClosesMinutesAfterShift": 60,
    "RepeatIgnoreMinutes": 5
  }
}
