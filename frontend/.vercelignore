# Used when Vercel Root Directory is set to `frontend/`
# Dependencies, build outputs, and caches
node_modules/
dist/
.vite/
coverage/
test-results/
playwright-report/

# Documentation and local dev hooks
README.md
.husky/

# Visual regression snapshots (not needed for build)
# Note: keep e2e/*.ts, playwright.config.ts, and tsconfig.e2e.json because
# `npm run build` runs `tsc -b` across all tsconfig.json project references.
e2e/**/*.png

# OS, logs, and temporary files
.DS_Store
**/.DS_Store
*.log
*.tmp

# Sensitive configuration
.env
.env.*
.env.local
.env.*.local
